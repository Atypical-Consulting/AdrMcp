<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet global tool + MCP server packaging. Version + author/license/URL metadata is shared
         in Directory.Build.props (bumped by release-please). PackageType=McpServer lets
         `dnx`/registry clients discover this as an MCP server; the .mcp/server.json manifest
         (packed below) declares the runnable package. -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>adr-mcp</ToolCommandName>
    <PackageId>AdrMcp</PackageId>
    <Description>MCP server for Architectural Decision Records (ADRs): navigate, author, validate, link, and analyze decisions on disk.</Description>
    <PackageTags>mcp;adr;architecture;decision-records;madr</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Docker container support (dotnet publish /t:PublishContainer). -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>atypical-consulting/adr-mcp</ContainerRepository>
    <ContainerFamily>alpine</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the README (NuGet package page) and the MCP registry manifest inside the package.
         The manifest MUST be present so `dnx`-based clients resolve the declared version; its
         version is stamped to the release version by release-please.yml before packing. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../.mcp/server.json" Pack="true" PackagePath=".mcp/server.json" />
  </ItemGroup>

</Project>
