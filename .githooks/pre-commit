#!/bin/sh
# Commit attribution policy (enforced).
#
# Every commit in this repository must be authored by phmatray@gmail.com.
# Enable this hook in a fresh clone with:
#
#     git config core.hooksPath .githooks
#
required_email="phmatray@gmail.com"

# GIT_AUTHOR_IDENT reflects the author that will actually be recorded — it honors
# user.email config and any GIT_AUTHOR_EMAIL override, so this catches both.
author_email=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')

if [ "$author_email" != "$required_email" ]; then
  echo "✖ Commit rejected: author <$author_email> violates the attribution policy." >&2
  echo "  Every commit must be authored by <$required_email>." >&2
  echo "  Fix: git config user.email $required_email" >&2
  exit 1
fi
